# Sandbox/workbench credentials. Values are runtime inputs, never committed.
BASE=
PROJECT=ailab-llmit
OPEN_SANDBOX_ACCESS_KEY=
OPEN_SANDBOX_SECRET_KEY=

# Teacher and student use this OpenAI-compatible Chat endpoint by default.
OPENAI_BASE_URL=
OPENAI_API_KEY=

# Mount containing the fixed WebArena-Verified 1.2.3 assets/tools.
ASSET_SUBPATH=eval/benchmark/webarena-verified/1.2.3

# Optional model-specific overrides.
QWEN_BASE_URL=
QWEN_API_KEY=
GLM_BASE_URL=
GLM_API_KEY=
